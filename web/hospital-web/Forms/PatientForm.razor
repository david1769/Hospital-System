@page "/create-patient"
@inject HttpClient Http

<!-- The EditForm is the foundation for all Blazor data-bound forms -->
<EditForm Model="@NewPatient" OnValidSubmit="@HandleValidSubmit">

    <!-- Hooks up the validation attributes from Patient.cs -->
    <DataAnnotationsValidator />

    <!-- Displays all validation error messages -->
    @if (!string.IsNullOrEmpty(statusMessage) && statusMessage.Contains("Error"))
    {
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 mb-4 rounded-md">
            @statusMessage
        </div>
    }
    <ValidationSummary class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-3 mb-4 rounded-md" />

    <div class="space-y-4 p-6 bg-white shadow-lg rounded-xl">
        <h4 class="text-xl font-semibold text-gray-800 border-b pb-2 mb-4">Register New Patient</h4>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- First Name -->
            <div class="col-span-1">
                <label for="firstName" class="block text-sm font-medium text-gray-700">First Name *</label>
                <InputText id="firstName" @bind-Value="NewPatient.FirstName" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => NewPatient.FirstName)" class="text-xs text-red-500" />
            </div>

            <!-- Last Name -->
            <div class="col-span-1">
                <label for="lastName" class="block text-sm font-medium text-gray-700">Last Name *</label>
                <InputText id="lastName" @bind-Value="NewPatient.LastName" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => NewPatient.LastName)" class="text-xs text-red-500" />
            </div>

            <!-- Date of Birth -->
            <div class="col-span-1">
                <label for="dob" class="block text-sm font-medium text-gray-700">Date of Birth *</label>
                <InputDate id="dob" @bind-Value="NewPatient.DateOfBirth" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => NewPatient.DateOfBirth)" class="text-xs text-red-500" />
            </div>

            <!-- Phone (Using InputText for string property 'Phone') -->
            <div class="col-span-1">
                <label for="phone" class="block text-sm font-medium text-gray-700">Phone</label>
                <InputNumber id="phone" @bind-Value="NewPatient.PhoneNumber" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => NewPatient.PhoneNumber)" class="text-xs text-red-500" />
            </div>

            <!-- Email -->
            <div class="col-span-1">
                <label for="email" class="block text-sm font-medium text-gray-700">Email</label>
                <InputText id="email" @bind-Value="NewPatient.Email" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2" />
                <ValidationMessage For="@(() => NewPatient.Email)" class="text-xs text-red-500" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(statusMessage) && statusMessage.Contains("successfully"))
        {
            <div class="bg-green-100 border-l-4 border-green-500 text-green-700 p-3 rounded-md">
                @statusMessage
            </div>
        }

        <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-lg transition duration-150 shadow-md">
            <span class="inline-flex items-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
                Register Patient
            </span>
        </button>
    </div>

</EditForm>

@code {
    // Initialize the model instance with DateOfBirth set to today for better UX
    private Patient NewPatient = new Patient { DateOfBirth = DateTime.Today };

    [Parameter] 
    public Patient? PatientToEdit { get; set; }
    [Parameter] 
    public EventCallback OnPatientUpdated { get; set; }

    [Parameter] 
    public EventCallback OnPatientCreated { get; set; }

    private string statusMessage = "";
    protected override void OnParametersSet()
    {
        if (PatientToEdit != null)
        {
            // Copy data from PatientToEdit into NewPatient to bind the form
            NewPatient = new Patient
            {
                Id = PatientToEdit.Id,
                FirstName = PatientToEdit.FirstName,
                LastName = PatientToEdit.LastName,
                DateOfBirth = PatientToEdit.DateOfBirth,
                PhoneNumber = PatientToEdit.PhoneNumber,
                Email = PatientToEdit.Email
            };
        }
    }
    private async Task HandleValidSubmit()
    {
        statusMessage = "Registering patient...";
        try
        {
            // FIX: Use the relative path "api/patients". HttpClient uses its pre-configured BaseAddress.
            statusMessage = "Saving...";
            HttpResponseMessage response;


            // --- 4. THE POST vs. PUT LOGIC SWITCH ---
            if (NewPatient.Id != 0)
            {
                response = await Http.PutAsJsonAsync($"http://localhost:5297/api/Patient/{NewPatient.Id}", NewPatient);
            }
            else
            {
                response = await Http.PostAsJsonAsync("http://localhost:5297/api/Patient/create-patient", NewPatient);
            }

            // --- Response Handling and Callback Invocation ---
            if (response.IsSuccessStatusCode)
            {
                if (NewPatient.Id != 0)
                {
                    statusMessage = "Patient updated successfully!";
                    // Notify the parent (PatientEdit) to handle navigation
                    await OnPatientUpdated.InvokeAsync();
                }
                else
                {
                    statusMessage = "Patient registered successfully!";
                    NewPatient = new Patient { DateOfBirth = DateTime.Today }; // Reset form for next entry
                                                                               // Notify the parent (PatientManagement) to refresh the list
                    await OnPatientCreated.InvokeAsync();
                }
            }

        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving patient: {ex.Message}. Please check your API endpoints.";
        }
    }
}
