<div class="bg-white shadow-md rounded-xl overflow-hidden hover:shadow-xl transition-shadow duration-200 border border-gray-100">
    <div class="p-6">
        <div class="flex align-items-center gap">
            <div class="w-16 h-16 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-2xl shrink-0">
                @(GetDoctorInitials())
            </div>
            <div class="min-w-0 flex-1">
                <h3 class="text-lg font-semibold text-gray-900 truncate">
                    Dr. @Doctor.FullName
                </h3>
                @if (!string.IsNullOrWhiteSpace(Doctor.SpecialtyName))
                {
                    <span class="inline-block px-3 py-1 mt-1 bg-blue-50 text-blue-700 text-sm font-medium rounded-full">
                        @Doctor.SpecialtyName
                    </span>
                }
                @if (!string.IsNullOrWhiteSpace(Doctor.DepartmentName))
                {
                    <span class="inline-block px-3 py-1 mt-1 ml-2 bg-purple-50 text-purple-700 text-sm font-medium rounded-full">
                        @Doctor.DepartmentName
                    </span>
                }
            </div>
        </div>

        <div class="mt-5 grid grid-cols-2 gap-4 text-sm text-gray-600">
            @if (Doctor.YearsOfExperience.HasValue)
            {
                <div>
                    <span class="font-medium text-gray-700">Experience:</span><br />
                    @Doctor.YearsOfExperience years
                </div>
            }
            @if (Doctor.LicenseNumber.HasValue)
            {
                <div>
                    <span class="font-medium text-gray-700">License Number:</span><br />
                    @Doctor.LicenseNumber
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Doctor.Email))
            {
                <div class="col-span-2">
                    <span class="font-medium text-gray-700">Email:</span><br />
                    @Doctor.Email
                </div>
            }
        </div>
    </div>

    <div class="px-6 py-4 bg-gray-50 border-t border-gray-100 flex gap-3">
        <button @onclick="OnView"
        class="flex-1 py-2 px-4 bg-blue-600 text-white text-sm font-medium rounded-lg hover:bg-blue-700 transition">
            View Profile
        </button>
        <button @onclick="OnEdit"
        class="flex-1 py-2.5 px-3 border border-gray-300 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-100 transition">
            Edit
        </button>

        <button @onclick= "OnDelete"
                class="p-2.5 text-red-600 hover:text-red-800 hover:bg-red-50 rounded-lg transition duration-200"
                title="Delete doctor" aria-label="Delete doctor">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
        </button>
    </div>

</div>

@code {
    [Parameter] public Doctor Doctor { get; set; } = default!;
    [Parameter] public EventCallback OnView { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private string GetDoctorInitials()
    {
        if (Doctor == null) return "?";

        var first = Doctor.FirstName?.FirstOrDefault() ?? '?';
        var last = Doctor.LastName?.FirstOrDefault() ?? '?';

        return $"{char.ToUpper(first)}{char.ToUpper(last)}";
    }


}
