@page "/patients/details/{PatientId:int}"
@inject PatientService PatientService
@inject NavigationManager Navigation

<PageTitle>Patient Details</PageTitle>

<div class="container mx-auto p-6 max-w-5xl">
    <div class="flex items-center justify-between mb-8">
        <button @onclick="GoBack"
                class="flex items-center gap-2 text-gray-600 hover:text-gray-800">
            ← Back to Patient List
        </button>
        <button @onclick="EditPatient"
                class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-medium">
            Edit Patient
        </button>
    </div>

    @if (patient == null)
    {
        <p class="text-center py-12 text-gray-500">Loading patient information...</p>
    }
    else
    {
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            
            <!-- Patient Info Card -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-3xl shadow p-8 text-center">
                    <div class="w-32 h-32 mx-auto bg-blue-100 rounded-full flex items-center justify-center text-5xl font-bold text-blue-600 mb-6">
                        @patient.FirstName?[0]@patient.LastName?[0]
                    </div>
                    <h2 class="text-2xl font-bold text-gray-800">@patient.FullName</h2>
                    <p class="text-gray-500 mt-1">Patient Code: <span class="font-medium">@patient.Id</span></p>
                    
                    <div class="mt-8 space-y-4 text-left">
                        <div>
                            <p class="text-sm text-gray-500">Date of Birth</p>
                            <p class="font-medium">@patient.DateOfBirth?.ToString("dd MMMM yyyy")</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Phone Number</p>
                            <p class="font-medium">@patient.PhoneNumber</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Email Address</p>
                            <p class="font-medium">@patient.Email</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Address</p>
                            <p class="font-medium">@patient.Address</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Medical History & Actions -->
            <div class="lg:col-span-2 space-y-6">
                <!-- Quick Actions -->
                <div class="bg-white rounded-3xl shadow p-6">
                    <h3 class="font-semibold text-lg mb-4">Quick Actions</h3>
                    <div class="grid grid-cols-2 gap-4">
                        <button class="p-6 border border-gray-200 rounded-2xl hover:border-blue-500 hover:bg-blue-50 transition text-left">
                            <p class="font-medium">Book Appointment</p>
                            <p class="text-sm text-gray-500 mt-1">Schedule a new visit</p>
                        </button>
                        <button class="p-6 border border-gray-200 rounded-2xl hover:border-blue-500 hover:bg-blue-50 transition text-left">
                            <p class="font-medium">View Medical History</p>
                            <p class="text-sm text-gray-500 mt-1">Previous visits & notes</p>
                        </button>
                    </div>
                </div>

                <!-- Patient Information Details -->
                <div class="bg-white rounded-3xl shadow p-8">
                    <h3 class="font-semibold text-lg mb-6">Patient Information</h3>
                    <div class="grid grid-cols-2 gap-y-8">
                        <div>
                            <p class="text-sm text-gray-500">Full Name</p>
                            <p class="font-medium text-lg">@patient.FullName</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Gender</p>
                            <p class="font-medium">@patient.Gender</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">ID Number</p>
                            <p class="font-medium">@patient.NationalIdNumber</p>
                        </div>
                        <div>
                            <p class="text-sm text-gray-500">Registration Date</p>
                            <p class="font-medium">@patient.CreatedAt?.ToString("dd MMMM yyyy")</p>
                        </div>
                    </div>
                </div>

                <!-- Notes Section -->
                <div class="bg-white rounded-3xl shadow p-8">
                    <h3 class="font-semibold text-lg mb-4">Additional Notes</h3>
                    <p class="text-gray-700 leading-relaxed">@("No additional notes available.")</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int PatientId { get; set; }

    private Patient? patient;

    protected override async Task OnInitializedAsync()
    {
        patient = await PatientService.GetByIdAsync(PatientId);
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/patients");
    }

    private void EditPatient()
    {
        Navigation.NavigateTo($"/patients/edit/{PatientId}");
    }
}