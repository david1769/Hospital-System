@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject DoctorService DoctorService
@inject IJSRuntime JSRuntime
@page "/doctors"
@using hospital_web.Cards
<div class="min-h-screen bg-gray-50">
    <div class="container mx-auto px-4 py-8">

        <!-- Header + Actions -->
        <div class="flex-column flex-column sm:flex-row justify-content-between align-items-start align-items-sm-center mb-8 gap-4">
            <h1 class="text-3xl font-bold text-gray-800">Doctors</h1>

            <div class="flex gap-3">
                <input type="text"
                       @bind="searchTerm"
                       placeholder="Search by name or specialty..."
                       class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 w-64" />

                       <!-- Search Button -->
                <button @onclick="PerformSearch"
                        class="px-5 py-2 bg-blue-600 text-white font-medium rounded-lg shadow hover:bg-blue-700 transition flex items-center gap-2">
                    <span>🔍</span> Search
                </button>

                <button @onclick="NavigateToCreate"
                        class="px-6 py-2 bg-blue-600 text-white font-medium rounded-lg shadow hover:bg-blue-700 transition">
                    + Add Doctor
                </button>

        </div>

        </div>
        <!-- Doctors Grid -->
        @if (doctors == null)
        {
            <p class="text-center text-gray-500 py-12">Loading doctors...</p>
        }
        else if (!doctors.Any())
        {
            <p class="text-center text-gray-500 py-12">No doctors found.</p>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                @foreach (var doctor in doctors)
                {
                    <DoctorCardComponent Doctor="doctor" 
                                OnView="() => ViewDoctor(doctor.Id)" 
                                OnEdit="() => EditDoctor(doctor.Id)"
                                OnDelete="() => ShowDeleteConfirm(doctor.Id)"
/>

                   
                }
            </div>
        }



    </div>
    @if (showDeleteConfirm && doctorIdToDelete.HasValue)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirm Delete</h5>
                        <button type="button" class="btn-close" @onclick="CancelDelete"></button>
                    </div>
                    <div class="modal-body">
                        Are you sure you want to delete Dr. @currentDoctorName?<br />
                        <small class="text-muted">This action cannot be undone.</small>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CancelDelete">Cancel</button>
                        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete</button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>



@code {
    private List<Doctor>? doctors;
    private string searchTerm = string.Empty;
    public string? errorMessage { get; set; }
    private bool showDeleteConfirm = false;
    private int? doctorIdToDelete;
    private string currentDoctorName = "";
    private bool isLoading = true;

    private System.Timers.Timer? _debounceTimer;

    




    // Use a method to load/refresh data (called on init and after form submit)


    protected override async Task OnInitializedAsync()
    {
        _debounceTimer = new System.Timers.Timer(400); // 400ms debounce
        _debounceTimer.Elapsed += async (s, e) => await PerformSearch();
        _debounceTimer.AutoReset = false;

        await LoadDoctersAsync();
    }


    private async Task LoadDoctersAsync()
    {
        isLoading = true;
        await PerformSearch();
        isLoading = false;
    }

    public async Task NavigateToCreate()
    {
        NavigationManager.NavigateTo("/doctors/create");


    }

    public async Task ViewDoctor(int id)
    {
        NavigationManager.NavigateTo($"/doctors/{id}");

    }

    public async Task EditDoctor(int id)
    {
        NavigationManager.NavigateTo($"/doctors/edit/{id}");
    }

    private void ShowDeleteConfirm(int id)
    {
        var doc = doctors.FirstOrDefault(d => d.Id == id);
        if (doc != null)
        {
            doctorIdToDelete = id;
            currentDoctorName = $"{doc.FirstName} {doc.LastName}";
            showDeleteConfirm = true;
        }
    }


    private async Task ConfirmDelete()
    {
        if (!doctorIdToDelete.HasValue) return;

        try
        {
            var success = await DoctorService.DeleteAsync(doctorIdToDelete.Value);
            if (success)
            {
                doctors.RemoveAll(d => d.Id == doctorIdToDelete.Value);
                await JSRuntime.InvokeVoidAsync("alert", $"Doctor '{currentDoctorName}' has been deleted.");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", $"Failed to delete doctor '{currentDoctorName}'. Please try again.");
            }
        }catch(Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }

        showDeleteConfirm = false;
        doctorIdToDelete = null;
        currentDoctorName = "";
        StateHasChanged();
    }

    private void CancelDelete()
    {
        showDeleteConfirm = false;
        doctorIdToDelete = null;
        currentDoctorName = "";
    
    }

    private async Task PerformSearch()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                doctors = await DoctorService.GetAllAsync() ?? new();
            }
            else
            {
                var pagedResult = await DoctorService.SearchPagedAsync(searchTerm.Trim());
                doctors = pagedResult?.Items?.ToList() ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            doctors.Clear();
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

 
   }