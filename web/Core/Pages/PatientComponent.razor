@page "/patients"
@inject NavigationManager Navigation
@inject PatientService PatientService
@inject IJSRuntime JsRuntime

<PageTitle>Patient Records</PageTitle>

<div class="container mx-auto p-6">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-800">Patient Records</h1>
            <p class="text-gray-500 mt-1">Manage and view all registered patients</p>
        </div>
        
        <button @onclick="NavigateToRegister"
                class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-medium flex items-center gap-3 shadow-lg transition">
            <span class="text-2xl leading-none">+</span>
            Register New Patient
        </button>
    </div>

    <!-- Search and Filters -->
<div class="bg-white p-5 rounded-3xl shadow flex flex-col md:flex-row gap-4 mb-8">
    <div class="flex-1">
        <input type="text" 
               @bind="searchTerm" 
               @bind:event="oninput"
               @bind:after="OnSearchChanged"
               placeholder="Search patients by name, code, phone or email..."
               class="w-full px-5 py-4 border border-gray-300 rounded-2xl focus:outline-none focus:border-blue-500 text-lg" />
    </div>
    
    <button @onclick="RefreshPatients"
            class="px-8 py-4 bg-gray-100 hover:bg-gray-200 rounded-2xl font-medium whitespace-nowrap">
        Refresh
    </button>
</div>

    <!-- Patient Table -->
    <div class="bg-white rounded-3xl shadow overflow-hidden">
        <table class="w-full min-w-full">
            <thead class="bg-gray-50 border-b">
                <tr>
                    <th class="text-left py-5 px-6 font-semibold text-gray-600">Patient Code</th>
                    <th class="text-left py-5 px-6 font-semibold text-gray-600">Full Name</th>
                    <th class="text-left py-5 px-6 font-semibold text-gray-600">Date of Birth</th>
                    <th class="text-left py-5 px-6 font-semibold text-gray-600">Phone</th>
                    <th class="text-left py-5 px-6 font-semibold text-gray-600">Email</th>
                    <th class="text-center py-5 px-6 font-semibold text-gray-600">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @if (patients == null)
                {
                    <tr>
                        <td colspan="6" class="text-center py-16 text-gray-500">
                            Loading patients...
                        </td>
                    </tr>
                }
                else if (patients.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-16 text-gray-500">
                            No patients found. <button @onclick="NavigateToRegister" class="text-blue-600 underline">Register one now</button>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in patients)
                    {
                        <tr class="hover:bg-blue-50 transition cursor-pointer group"
                            @onclick="() => ViewPatient(p.Id)">
                            <td class="py-5 px-6 font-medium text-gray-700">@p.Id</td>
                            <td class="py-5 px-6 font-medium">@p.FullName</td>
                            <td class="py-5 px-6">@p.DateOfBirth?.ToString("dd MMM yyyy")</td>
                            <td class="py-5 px-6">@p.PhoneNumber</td>
                            <td class="py-5 px-6 text-blue-600">@p.Email</td>


                            <td class="py-5 px-6 text-center">
                                <div class="flex items-center justify-center gap-3">
                                    <!-- View Button -->
                                    <button @onclick="() => ViewPatient(p.Id)"
                                            class="text-blue-600 hover:text-blue-700 font-medium flex items-center gap-1 hover:underline">
                                        View
                                    </button>
                                
                                    <!-- Delete Button -->
                                    <button @onclick="() => DeletePatient(p.Id, p.FullName)"
                                            class="text-red-600 hover:text-red-700 font-medium flex items-center gap-1 hover:underline">
                                        Delete
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                }
            </tbody>
        </table>
        <div class="bg-white px-6 py-4 flex items-center justify-between border-t">
            <div class="text-sm text-gray-500">
                Showing <span class="font-medium">@((currentPage - 1) * pageSize + 1)</span>
                to <span class="font-medium">@Math.Min(currentPage * pageSize, totalItems)</span>
                of <span class="font-medium">@totalItems</span> patients
        </div>

        <div class="flex items-center gap-2">
            <button @onclick="() => ChangePage(currentPage - 1)"
                disabled = "@(currentPage == 1)"
                        class="px-4 py-2 border rounded-xl hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">Previous
                    </button>
        </div>

            @for (int i = 1; i <= totalPages; i++)
            {
                var pageNum = i;
                <button @onclick="() => ChangePage(pageNum)"
                        class="@(currentPage == pageNum
                                                                        ? "bg-blue-600 text-white"
                                                                        : "border hover:bg-gray-50") px-4 py-2 rounded-xl">
            @pageNum
        </button>
    }


    <button @onclick="() => ChangePage(currentPage + 1)"
            disabled="@(currentPage == totalPages)"
            class="px-4 py-2 border rounded-xl hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
        Next
    </button>

        </div>

</div>

</div>

@code {
    private List<Patient> patients = new();
    private string searchTerm = "";
    private List<Patient> allPatients = new();

    // Pagination Properties
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalPages = 1;
    private int totalItems = 0;

    private CancellationTokenSource? debounceCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
    }

    private async Task LoadPatients()
    {
        try
        {
         
            allPatients = await PatientService.GetAllAsync() ?? new List<Patient>();

            totalItems = allPatients.Count;
            totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);

            currentPage = 1;
            await ApplyCurrentPage();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"LoadPatients Error: {ex.Message}");
            patients = new();
            totalPages = 1;
            totalItems = 0;
        }
    }

    private async Task ApplyCurrentPage()
    {
        patients = allPatients
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private async Task RefreshPatients()
    {
        await OnSearchChanged();
    }

    private void NavigateToRegister()
    {
        Navigation.NavigateTo("/create-patient");
    }

    private void ViewPatient(int patientId)
    {
        Navigation.NavigateTo($"/patients/details/{patientId}");
    }

    // Live search
    private async Task OnSearchChanged()
    {
        debounceCts?.Cancel();
        debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, debounceCts.Token);
            currentPage = 1;

            if (string.IsNullOrWhiteSpace(searchTerm))
            {
                await ApplyCurrentPage();
            }
            else
            {
                // Try server search first, fallback to client search
                try
                {
                    var response = await PatientService.SearchPagedAsync(searchTerm, currentPage, pageSize);
                    patients = response?.Items ?? new();
                    totalPages = response?.TotalPages ?? 1;
                    totalItems = response?.TotalItems ?? patients.Count;
                }
                catch
                {
                    // Client-side search fallback
                    var filtered = allPatients.Where(p =>
                        p.FullName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true ||
                        p.Id.ToString().Contains(searchTerm) ||
                        p.Email?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true
                    ).ToList();

                    patients = filtered.Skip((currentPage - 1) * pageSize).Take(pageSize).ToList();
                    totalItems = filtered.Count;
                    totalPages = (int)Math.Ceiling(totalItems / (double)pageSize);
                }
            }
        }
        catch (TaskCanceledException) { }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
        }

       
    }

   



    private async Task ChangePage(int page)
    {
        if (page < 1 || page > totalPages) return;

        currentPage = page;

        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            // ✅ Use ApplyCurrentPage instead of reloading everything
            await ApplyCurrentPage();
        }
        else
        {
            // For search, we re-run the search with the new page
            await OnSearchChanged();
        }

        // Optional: Scroll to top of table after changing page
        // await JsRuntime.InvokeVoidAsync("window.scrollTo", 0, 0);
    }


    private async Task DeletePatient(int patientId, string patientName)
    {
        var confirmed = await JsRuntime.InvokeAsync<bool>("confirm",
            $"Are you sure you want to delete patient '{patientName}'? This action cannot be undone.");

        if (!confirmed) return;

        try
        {
            var success = await PatientService.DeleteAsync(patientId);
        
            if (success)
            {
                await OnSearchChanged(); // Refresh current view (search or all)
                                         // Optional: Show success message-
                Console.WriteLine($"Patient {patientId} deleted successfully.");
            }
            else
            {
                Console.WriteLine("Failed to delete patient.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Delete error: {ex.Message}");
        }
    }

} 