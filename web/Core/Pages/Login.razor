@page "/login"
@inject HttpClient Http
@inject NavigationManager NavManager
@inject hospital_web.Services.IAuthService AuthService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@using System.Net.Http.Json
@using System.ComponentModel.DataAnnotations
@using global::Services
@using hospital_web.Services

<h3 class="text-3xl font-bold text-gray-900 mb-6 text-center">Hospital Staff Login</h3>

<div class="max-w-md mx-auto bg-white p-8 rounded-xl shadow-2xl border border-indigo-200">
    <EditForm Model="@loginModel" OnValidSubmit="@HandleLogin">
        <DataAnnotationsValidator />
        <ValidationSummary class="bg-red-100 border-l-4 border-red-500 text-red-700 p-3 mb-4 rounded-md text-sm" />

        <!-- Status Message Display -->
        @if (!string.IsNullOrEmpty(statusMessage))
        {
                <div class="@(statusMessage.Contains("successful") ? "bg-green-100 border-green-500 text-green-700" : "bg-red-100 border-red-500 text-red-700") border-l-4 p-3 mb-4 rounded-md text-sm">
                    <p>@statusMessage</p>
                </div>
        }

        <div class="space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium text-gray-700">Email Address</label>
                <InputText id="email" @bind-Value="loginModel.Email" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 focus:ring-indigo-500 focus:border-indigo-500" />
                <ValidationMessage For="@(() => loginModel.Email)" class="text-xs text-red-500" />
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-gray-700">Password</label>
                <InputText type="password" id="password" @bind-Value="loginModel.Password" class="mt-1 block w-full border border-gray-300 rounded-md shadow-sm p-2 focus:ring-indigo-500 focus:border-indigo-500" />
                <ValidationMessage For="@(() => loginModel.Password)" class="text-xs text-red-500" />
            </div>
        </div>

        <button type="submit" disabled="@isBusy" class="w-full mt-6 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded-lg transition duration-150 shadow-md disabled:opacity-50">
            @if (isBusy)
            {
                    <span class="inline-flex items-center">
                        <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        Logging in...
                    </span>
            }
            else
            {
                    <span>Login</span>
            }
        </button>

        <p class="mt-4 text-center text-sm text-gray-500">
            Hint: You'll need to register a user on the API first, or use a default seed user if available.
        </p>
    </EditForm>
</div>


@code {
    private class LoginModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }

    private class AuthResponse
    {
        public string Token { get; set; } = string.Empty;
        public string Expires { get; set; } = string.Empty;
    }

    private LoginModel loginModel = new LoginModel();
    private string statusMessage = string.Empty;
    private bool isBusy = false;

    private async Task HandleLogin()
    {
        isBusy = true;
        statusMessage = string.Empty;

        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/login", loginModel);

            if (response.IsSuccessStatusCode)
            {
                var authResponse = await response.Content.ReadFromJsonAsync<AuthResponse>();

                if (authResponse != null && !string.IsNullOrEmpty(authResponse.Token))
                {
                    // 1. Persist the Token and set the HttpClient header
                    await AuthService.SetTokenAsync(authResponse.Token);

                    // 2. Notify the state provider of the successful login
                    ((CustomAuthenticationStateProvider)AuthStateProvider).NotifyUserLogin(); // <-- NEW

                    statusMessage = "Login successful! Redirecting...";

                    // 3. Navigate the user to the secured patient management page
                    NavManager.NavigateTo("/patients"); // No force reload needed
                }
                else
                {
                    statusMessage = "Authentication failed: Token not received.";
                }
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                statusMessage = $"Login failed: {response.StatusCode}. Details: {errorContent}";
            }
        }
        catch (HttpRequestException ex)
        {
            statusMessage = $"Network error: Could not connect to API. {ex.Message}";
        }
        catch (Exception ex)
        {
            statusMessage = $"An unexpected error occurred: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}